  "pages": [
    {
      "id": "page:drift/overview",
      "module": "drift",
      "path": "/drift",
      "title": "Drift",
      "icon": "git-compare",
      "component": "DriftPage"
    },
    {
      "id": "page:inventory/host-detail",
      "module": "inventory",
      "path": "/hosts/:name",
      "title": "Host",
      "component": "HostDetailPage"
    },
    {
      "id": "page:inventory/hosts",
      "module": "inventory",
      "path": "/hosts",
      "title": "Hosts",
      "icon": "server",
      "component": "HostsPage"
    },
    {
      "id": "page:inventory/service-detail",
      "module": "inventory",
      "path": "/services/:host/:name",
      "title": "Service",
      "component": "ServiceDetailPage"
    },
    {
      "id": "page:inventory/services",
      "module": "inventory",
      "path": "/services",
      "title": "Services",
      "icon": "boxes",
