      "path": "/configs",
      "title": "Configs",
      "icon": "file-cog",
      "component": "ConfigsPage"
    },
    {
      "id": "page:sources/docs",
      "module": "sources",
      "path": "/docs",
      "title": "Docs",
      "icon": "book-open",
      "component": "DocsPage"
    }
