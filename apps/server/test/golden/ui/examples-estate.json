    {
      "id": "app/nav",
      "accepts": "nav",
      "module": "core"
    },
    {
      "id": "app/routes",
      "accepts": "page",
      "module": "core"
    },
    {
      "id": "app/topbar.actions",
      "accepts": "action",
      "module": "core"
    },
    {
      "id": "app/topbar.status",
      "accepts": "pill",
      "module": "core"
    },
    {
      "id": "entity:host/sections",
      "accepts": "entity-section",
      "module": "core"
    },
    {
      "id": "entity:service/sections",
