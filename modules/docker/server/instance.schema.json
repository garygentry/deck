{
  "title": "Docker integration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "baseUrl"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Integration id, unique across integrations."
    },
    "kind": {
      "const": "docker",
      "description": "Provider kind."
    },
    "title": {
      "type": "string",
      "description": "Human-readable integration title."
    },
    "baseUrl": {
      "type": "string",
      "description": "Base URL of the Docker API proxy."
    },
    "deepLink": {
      "type": "string",
      "description": "Optional deep-link template into the Docker API proxy."
    },
    "card": {
      "type": "object",
      "description": "Opaque provider-defined card specification.",
      "additionalProperties": true
    },
    "credentialEnv": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "Environment variable name holding a credential, never its value."
    }
  }
}
